// The profile README is generated by .github/scripts/build_readme.py and needs raw HTML
// (<picture> for light/dark images, tables with badges). These rules cannot apply to it.
{
  "config": {
    "MD013": false, // long lines: generated tables and badge rows
    "MD033": false, // inline HTML: <picture>, <details>, <table>
    "MD041": false  // the README starts with the language switch, not a heading
  },
  "ignores": [".qs-reports/**"]
}
